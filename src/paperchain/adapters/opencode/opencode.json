{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "writer",
  "permissions": [
    { "action": "edit", "resource": "References/**", "effect": "deny" },
    { "action": "edit", "resource": "Output/**", "effect": "deny" },
    { "action": "edit", "resource": "Manuscript/**", "effect": "deny" },
    { "action": "edit", "resource": "*.docx", "effect": "deny" },
    { "action": "edit", "resource": "*.pdf", "effect": "deny" },
    { "action": "edit", "resource": "paper.toml", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": ".gitignore", "effect": "deny" },
    { "action": "edit", "resource": ".gitattributes", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "paperchain* check*", "effect": "allow" },
    { "action": "shell", "resource": "paperchain* doctor*", "effect": "allow" },
    { "action": "shell", "resource": "paperchain* build*", "effect": "allow" },
    { "action": "shell", "resource": "* --force*", "effect": "deny" },
    { "action": "shell", "resource": "* unlock*", "effect": "deny" },
    { "action": "shell", "resource": "* init*", "effect": "deny" },
    { "action": "shell", "resource": "* convert*", "effect": "deny" },
    { "action": "shell", "resource": "* import*", "effect": "deny" },
    { "action": "shell", "resource": "* lock*", "effect": "deny" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "scout", "effect": "allow" }
  ]
}
