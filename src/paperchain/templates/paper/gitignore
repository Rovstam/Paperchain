# Reference files and their extracted text are copies of other people's work.
References/originals/*
!References/originals/.gitkeep
References/_text/*
!References/_text/.gitkeep
References/**/*.pdf
References/**/*.docx
References/**/*.txt
References/**/*.md

# The original manuscript is private too.
Manuscript/*
!Manuscript/.gitkeep
/*.docx
/*.pdf

# Generated documents
Output/*
!Output/.gitkeep

# Never commit downloaded candidate files.
Candidates/*.pdf
Candidates/*.docx
Candidates/*.doc
Candidates/*.epub

# Build scratch
Paper/.paperchain.build.md
*.tmp
